<?xml version="1.0"?>
<!DOCTYPE hibernate-mapping PUBLIC
        "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
        "http://www.hibernate.org/dtd/hibernate-mapping-3.0.dtd">

<!-- Small mapping in quoted-identifier style: backtick-quoted table and columns,
     id+generator, version, typed properties, many-to-one, set and component. -->
<hibernate-mapping package="org.example.library">

    <class name="Library" table="`LIBRARY`"
           dynamic-insert="true"
           optimistic-lock="version"
           lazy="true"
           batch-size="300">

        <id name="id" type="java.lang.Long" column="`libraryID`">
            <generator class="native"/>
        </id>

        <version name="version" type="java.lang.Long" access="field" column="OBJ_VERSION"/>

        <property name="name" column="`name`"
                  type="java.lang.String"
                  not-null="true"/>

        <property name="shortName" column="`shortName`"
                  type="java.lang.String"
                  not-null="false"/>

        <property name="created" column="`created`"
                  type="timestamp" not-null="true" length="6"/>

        <property name="requiresMembership" column="`requiresMembership`"
                  type="java.lang.Boolean" not-null="false"/>

        <property name="maxMembers" column="`maxMembers`"
                  type="java.lang.Integer" not-null="false"/>

        <property name="annualBudget" column="`annualBudget`"
                  type="java.lang.Double" not-null="false"/>

        <property name="deleted" type="java.lang.Boolean">
            <column name="deleted" not-null="true" default="0"/>
        </property>

        <many-to-one
            name="createdBy"
            column="`createdByID`"
            class="org.example.library.Member"
            not-null="true"/>

        <many-to-one
            name="accessPolicy"
            class="org.example.library.AccessPolicy"
            column="`accessPolicyID`"
            not-null="false"/>

        <set name="branches" table="`BRANCH`"
             inverse="true" cascade="all-delete-orphan" lazy="true">
            <key column="`libraryID`"/>
            <one-to-many class="org.example.library.Branch"/>
        </set>

        <component name="libraryAddress" class="org.example.library.Address">
            <property name="address1" type="java.lang.String" column="`library_address1`" not-null="false"/>
            <property name="city" type="java.lang.String" column="`library_city`" not-null="false"/>
            <property name="state" type="java.lang.String" column="`library_state`" not-null="false"/>
        </component>

    </class>

</hibernate-mapping>
